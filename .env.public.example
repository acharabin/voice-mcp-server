# Keycloak initial admin. Set unique long passwords and protect this file (chmod 600).
KC_BOOTSTRAP_ADMIN_USERNAME=kc-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password

# PostgreSQL credentials for the production Keycloak instance.
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=replace-with-a-different-long-random-password

# The public app is served at the IP root over HTTPS by Caddy.
VOICE_APP_URL=https://138.197.152.248/
VOICE_APP_ORIGIN=https://138.197.152.248
