# Set a unique admin password before starting Keycloak.
KC_BOOTSTRAP_ADMIN_USERNAME=kc-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password

# Exact public app callback and origin. For local use, these are the defaults.
VOICE_APP_URL=http://localhost:10000/
VOICE_APP_ORIGIN=http://localhost:10000
