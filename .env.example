# Local voice app: bind to loopback. For a hosted deployment, set MCP_HOST=0.0.0.0
# and configure MCP_ALLOWED_HOSTS / MCP_ALLOWED_ORIGINS for that exact host.
MCP_HOST=127.0.0.1
MCP_PORT=10000
MCP_SERVER_URL=http://127.0.0.1:10000/mcp
MCP_ALLOWED_HOSTS=127.0.0.1:10000,localhost:10000
MCP_ALLOWED_ORIGINS=http://127.0.0.1:10000,http://localhost:10000

# Leave OAuth values blank for a loopback-only local server.
# To expose the server beyond this machine, configure all four values and
# register a public SPA client with authorization code + PKCE (S256).
OAUTH_ISSUER=
OAUTH_CLIENT_ID=
OAUTH_AUDIENCE=
OAUTH_SCOPE=voice:generate
OAUTH_REDIRECT_URI=
OAUTH_JWT_ALGORITHMS=RS256
# Set true only when deliberately testing OAuth through a localhost SSH tunnel.
OAUTH_FORCE_LOOPBACK=false
# Example local Keycloak values are documented in docs/keycloak-setup.md.
# OAUTH_ISSUER=http://localhost:8080/realms/voice-ai
# OAUTH_CLIENT_ID=voice-ai-web
# OAUTH_AUDIENCE=voice-ai-api
# OAUTH_REDIRECT_URI=http://localhost:10000/
TACOTRON2_CHECKPOINT=models/checkpoint_Tacotron2_1000.pt
UNIVNET_CHECKPOINT=models/univ_c32_AC_2141.pt

# Deployment target: http://159.203.49.85:5000
# Deployment reference only: replace the active settings above when configuring the Ubuntu host; do not leave duplicate active keys.
# MCP_HOST=0.0.0.0
# MCP_PORT=5000
# MCP_SERVER_URL=http://159.203.49.85:5000/mcp
# MCP_ALLOWED_HOSTS=159.203.49.85:5000
# MCP_ALLOWED_ORIGINS=http://159.203.49.85:5000
# OAUTH_REDIRECT_URI=http://159.203.49.85:5000/
# Set OAUTH_ISSUER, OAUTH_CLIENT_ID, and OAUTH_AUDIENCE to your identity provider values.
# Use HTTPS for production OAuth deployments.

# Server-side key for conversational responses; never sent to the browser.
OPENAI_API_KEY=
AGENT_MODEL=openai:gpt-4.1-mini

