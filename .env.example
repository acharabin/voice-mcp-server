# Local voice app: bind to loopback. For public deployment behind a reverse proxy,
# keep it on loopback and configure the proxy plus the public HTTPS URLs.
MCP_HOST=127.0.0.1
MCP_PORT=10000
MCP_SERVER_URL=http://127.0.0.1:10000/mcp
MCP_ALLOWED_HOSTS=127.0.0.1:10000,localhost:10000
MCP_ALLOWED_ORIGINS=http://127.0.0.1:10000,http://localhost:10000

# Leave OAuth values blank for a loopback-only local server.
# To expose the server beyond this machine, configure all four values and
# register a public SPA client with authorization code + PKCE (S256).
OAUTH_ISSUER=
OAUTH_CLIENT_ID=
OAUTH_AUDIENCE=
OAUTH_SCOPE=voice:generate
OAUTH_REDIRECT_URI=
OAUTH_JWT_ALGORITHMS=RS256
# Set true behind a loopback SSH tunnel or a local reverse proxy so OAuth remains enforced.
OAUTH_FORCE_LOOPBACK=false
# Example local Keycloak values are documented in docs/keycloak-setup.md.
# OAUTH_ISSUER=http://localhost:8080/realms/voice-ai
# OAUTH_CLIENT_ID=voice-ai-web
# OAUTH_AUDIENCE=voice-ai-api
# OAUTH_REDIRECT_URI=http://localhost:10000/
TACOTRON2_CHECKPOINT=models/voice/checkpoint_Tacotron2_1000.pt
UNIVNET_CHECKPOINT=models/voice/univ_c32_AC_2141.pt

# Public IP deployment example: see docs/keycloak-setup.md and .env.public.example.
# Keep MCP_HOST=127.0.0.1 behind Caddy; use the public HTTPS origin and issuer.

# Server-side key for conversational responses; never sent to the browser.
OPENAI_API_KEY=
AGENT_MODEL=openai:gpt-4.1-mini

# Default text backend; each request can override with provider=openai or qwen.
TEXT_MODEL_PROVIDER=openai
# Runpod vLLM OpenAI-compatible base URL (not /run or /runsync).
QWEN_BASE_URL=
# Runpod-issued key restricted to your endpoint; stored only on this server.
QWEN_API_KEY=
# Exact served model/adapter name exposed by the endpoint.
QWEN_MODEL=persona
QWEN_MAX_NEW_TOKENS=200
# Allow time for serverless cold starts; automatic retries are disabled.
QWEN_TIMEOUT_SECONDS=300
